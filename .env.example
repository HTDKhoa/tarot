# Sao chép thành .env.local (chạy local) và .dev.vars (preview Cloudflare).
# Trên Cloudflare: đặt các biến NEXT_PUBLIC_* trong Build variables, còn khóa bí mật thì dùng `npx wrangler secret put TÊN`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa bí mật (secret / service_role). CHỈ dùng phía server, cho webhook thanh toán.
SUPABASE_SECRET_KEY=

# payOS -> Kênh thanh toán -> Thông tin tích hợp
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
