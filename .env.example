# Sao chép thành .env.local (chạy local) và .dev.vars (preview Cloudflare).
# Trên Cloudflare: đặt các biến NEXT_PUBLIC_* trong Build variables, còn khóa bí mật thì dùng `npx wrangler secret put TÊN`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa bí mật (secret / service_role). CHỈ dùng phía server: ghi lá bài, lời thoại, xóa dữ liệu, webhook thanh toán.
SUPABASE_SECRET_KEY=

# payOS -> Kênh thanh toán -> Thông tin tích hợp
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Anthropic -> console.anthropic.com -> API Keys. Khóa bí mật, chỉ dùng phía server: Nguyệt chọn cách trải và viết nghĩa từng lá theo câu hỏi.
# Để trống thì máy chủ đoán cách trải bằng từ khóa và ghép lời từ dữ liệu (miễn phí). Có khóa thì mỗi lần trải bài tốn hai lượt gọi Claude Haiku 5.5.
ANTHROPIC_API_KEY=

# Bản production thiếu biến Supabase sẽ báo lỗi và đóng cửa thay vì chạy demo.
# Muốn cố ý chạy chế độ demo trên production (ví dụ `npm run preview` chưa có Supabase) thì bật dòng dưới.
# DEMO_MODE=1
